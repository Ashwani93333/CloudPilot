# Git ignore for CloudPilot

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
frontend/node_modules/
frontend/dist/

# Java / Maven
target/
backend/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE / Editor
.idea/
*.iml
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Environment and secrets
.env
*.env.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Docker storage
pgdata/
