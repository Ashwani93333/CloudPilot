# ==============================================================================
# CloudPilot Environment Configuration Template
# Copy this file to .env and configure local/production values.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Application Environment
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot_user
POSTGRES_PASSWORD=cloudpilot_secure_password_dev123!
DB_HOST=localhost
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/cloudpilot
DB_USER=cloudpilot_user
DB_PASSWORD=cloudpilot_secure_password_dev123!

# Security & JWT Configuration
# Generate a strong 256-bit or 512-bit secret for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Billing Ingestion Limits & Processing
MAX_UPLOAD_MB=50
IMPORT_BATCH_SIZE=2000

# AWS Integration (Read-only Cost Explorer / CloudWatch)
# Set to 'mock' for local mock adapter, or 'aws' with valid credentials
AWS_ADAPTER_MODE=mock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Alerts & Email (Optional SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_SENDER_EMAIL=alerts@cloudpilot.internal

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
